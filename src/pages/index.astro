---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Varifocal">
	<Header />

	<main class="hero">
		<div class="hero-content">
			<img
				src="/favicon.svg"
				alt="Varifocal profile picture"
				class="hero-avatar"
				width="192"
				height="192"
			/>
			<h1 class="hero-name">Varifocal</h1>
			<p class="hero-tagline">Just a guy</p>
		</div>
	</main>
</BaseLayout>

<link rel="stylesheet" href="/styles/hero.css" />
